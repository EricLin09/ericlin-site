<div class="solar-bg" aria-hidden="true">
  <canvas id="solar-canvas"></canvas>
  <div class="dimmer"></div>
</div>

<style>
  .solar-bg {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  #solar-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 暗色遮罩：只在最左下角留亮，文字区域（中部偏左起）整体压暗保证可读性 */
  .dimmer {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 8% 75%,
      rgba(2, 6, 23, 0.1) 0%,
      rgba(2, 6, 23, 0.55) 40%,
      rgba(2, 6, 23, 0.75) 100%
    );
  }
</style>

<script>
  // 星空是 hero 的背景，但 .solar-bg 是 fixed 的，不处理的话会一直垫在下方所有内容后面，
  // 太阳正好压在 Latest Posts 的正文上。滚过首屏就把它淡出，下面的内容回到纯 slate-950。
  const bg = document.querySelector<HTMLElement>('.solar-bg');
  if (bg) {
    const root = document.documentElement;
    let queued = false;
    const update = () => {
      queued = false;
      const fade = Math.min(window.scrollY / (window.innerHeight * 0.85), 1);
      bg.style.opacity = String(1 - fade);
      // 完全淡出后让渲染循环停下来，不白烧 GPU
      root.dataset.solarVisible = fade < 1 ? '1' : '0';
    };
    update();
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
  }

  // three.js 加后处理链和十几张贴图都不该挡在首屏前面：等浏览器空闲再拉整个场景模块。
  const start = () => import('./solar-system');
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => start(), { timeout: 2000 });
  } else {
    setTimeout(start, 200);
  }
</script>
