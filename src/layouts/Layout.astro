---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

const {
  title = 'Retrograde Resonance — Eric Lin',
  description = 'Personal site of Eric Lin — coursework notes and applied AI / machine learning projects.',
} = Astro.props;

// 课程内容因版权只存在本地（src/content/courses 已 gitignore），
// 线上构建时该集合为空 → 导航里不渲染 Courses 入口，避免空壳板块
const hasCourses = (await getCollection('courses')).length > 0;

const navLinks = [
  { href: '/', label: 'Home' },
  ...(hasCourses ? [{ href: '/courses', label: 'Courses' }] : []),
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isActive = (href) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Retrograde Resonance" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body class="bg-slate-950 text-slate-300 antialiased selection:bg-indigo-500/30 min-h-screen flex flex-col">

		<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
			<nav class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="font-bold text-white tracking-tight hover:text-indigo-400 transition">
					Retrograde<span class="text-indigo-400">.</span>
				</a>
				<div class="flex gap-6">
					{navLinks.map((link) => (
						<a
							href={link.href}
							class:list={[
								'text-sm transition',
								isActive(link.href)
									? 'text-white font-medium'
									: 'text-slate-400 hover:text-indigo-400',
							]}
						>
							{link.label}
						</a>
					))}
				</div>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-slate-800 py-8">
			<p class="max-w-4xl mx-auto px-6 text-sm text-slate-600">
				© 2026 Retrograde Resonance · Built with Astro ·
				Planet textures by <a href="https://www.solarsystemscope.com/textures/" target="_blank" rel="noopener" class="hover:text-slate-400 transition underline decoration-slate-700">Solar System Scope</a> (CC BY 4.0)
			</p>
		</footer>

	</body>
</html>
