---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const {
  title = 'Retrograde Resonance — Eric Lin',
  description = 'Machine learning projects, experiments and coursework notes by Eric Lin.',
  image = '/og-default.png',
} = Astro.props;

// 课程内容因版权只存在本地（src/content/courses 已 gitignore），
// 线上构建时该集合为空 → 导航里不渲染 Courses 入口，避免空壳板块
const hasCourses = (await getCollection('courses')).length > 0;

const navLinks = [
  // 手机宽度下放不下全部链接加搜索图标；左上角站名本身就链回首页，所以小屏省掉 Home
  { href: '/', label: 'Home', class: 'hidden sm:inline' },
  { href: '/blog', label: 'Blog' },
  ...(hasCourses ? [{ href: '/courses', label: 'Courses' }] : []),
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isActive = (href) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// 社交平台的抓取器只认绝对地址，相对路径会被当作没有图
const ogImage = Astro.site ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Retrograde Resonance" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		{ogImage && <meta property="og:image:width" content="1200" />}
		{ogImage && <meta property="og:image:height" content="630" />}
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="Retrograde Resonance" href={new URL('rss.xml', Astro.site)} />
		<slot name="head" />
	</head>
	<body class="bg-slate-950 text-slate-300 antialiased selection:bg-indigo-500/30 min-h-screen flex flex-col">
		<!-- 键盘用户按一次 Tab 就能跳过导航，直接到正文 -->
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-indigo-500 focus:text-white focus:text-sm focus:font-medium">Skip to content</a>

		<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
			<nav class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="font-bold text-white tracking-tight hover:text-indigo-400 transition">
					Retrograde<span class="text-indigo-400">.</span>
				</a>
				<div class="flex items-center gap-6">
					{navLinks.map((link) => (
						<a
							href={link.href}
							class:list={[
								'text-sm transition',
								link.class,
								isActive(link.href)
									? 'text-white font-medium'
									: 'text-slate-400 hover:text-indigo-400',
							]}
						>
							{link.label}
						</a>
					))}
					<!-- 图标 16px，内边距把点击区域撑到 24px，负外边距再抵掉，不多占导航宽度 -->
					<a
						href="/search"
						aria-label="Search"
						class:list={[
							'flex -m-1 p-1 transition',
							isActive('/search') ? 'text-white' : 'text-slate-400 hover:text-indigo-400',
						]}
					>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<circle cx="11" cy="11" r="7" />
							<path d="m20 20-3.5-3.5" />
						</svg>
					</a>
				</div>
			</nav>
		</header>

		<main id="main" class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-slate-800 py-8">
			<p class="max-w-4xl mx-auto px-6 text-sm text-slate-450">
				© 2026 Retrograde Resonance · Built with Astro ·
				Planet textures by <a href="https://www.solarsystemscope.com/textures/" target="_blank" rel="noopener" class="hover:text-slate-400 transition underline decoration-slate-700">Solar System Scope</a> (CC BY 4.0)
			</p>
		</footer>

	</body>
</html>
