---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/Layout.astro';
import SolarSystem from '../components/SolarSystem.astro';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  date.toISOString().slice(0, 10).replace(/-/g, ' / ');
---

<BaseLayout>
  <SolarSystem />
  <div class="max-w-4xl mx-auto px-6">

    <!-- Hero：占满首屏，文字垂直居中 -->
    <section class="relative min-h-[calc(100vh-4rem)] flex flex-col justify-center pb-24">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight leading-tight text-balance">
        Measure first, <span class="text-indigo-400">conclude second</span>
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl leading-relaxed mb-10 [text-shadow:0_1px_3px_rgba(2,6,23,0.9),0_0_16px_rgba(2,6,23,0.8)]">
        Machine learning projects, experiments and coursework notes.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/projects"
          class="px-5 py-2.5 rounded-full bg-indigo-500 text-white text-sm font-medium hover:bg-indigo-400 transition"
        >
          View Projects →
        </a>
        <a
          href="https://github.com/EricLin09"
          target="_blank"
          rel="noopener"
          class="px-5 py-2.5 rounded-full border border-slate-700 text-slate-300 text-sm font-medium hover:border-slate-500 hover:text-white transition inline-flex items-center gap-2"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          GitHub
        </a>
      </div>

      <!-- 向下滚动提示 -->
      <a
        href="#projects"
        aria-label="Scroll down"
        class="absolute bottom-10 left-1/2 -translate-x-1/2 text-slate-450 hover:text-slate-300 transition animate-bounce"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </a>
    </section>

    <!-- Projects -->
    <section id="projects" class="py-20">
      <h2 class="text-sm font-bold uppercase tracking-widest text-indigo-500 mb-8">Selected Research & Projects</h2>
      <!-- 三张卡共享行轨道（subgrid）：标题、正文、标签各占一条横带，每条取三张里最高的那张，
           所以一行标题和两行标题的卡，正文和标签依然对齐。纵向间距交给卡片自己的内边距。 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6">
        <a href="/projects/pseudo-positive-selection" class="group grid grid-rows-subgrid row-span-3 pt-5 pb-6 border-t border-slate-800 hover:border-indigo-400/70 transition">
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-300 transition">Pseudo-Positive Pair Selection</h3>
          <p class="text-sm text-slate-400 mb-4">48 fine-tuning runs with volume-matched random controls, separating what pair selection adds from what a smaller dataset does alone.</p>
          <span class="text-xs font-mono text-indigo-400">#PyTorch #contrastive #conformal</span>
        </a>
        <a href="/projects/hard-negatives" class="group grid grid-rows-subgrid row-span-3 pt-5 pb-6 border-t border-slate-800 hover:border-indigo-400/70 transition">
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-300 transition">Do Hard Negatives Always Help?</h3>
          <p class="text-sm text-slate-400 mb-4">One-variable test with hand-written InfoNCE: random negatives lift NDCG@10 from 0.369 to 0.397 and beat BM25-hard ones in all 3 seeds.</p>
          <span class="text-xs font-mono text-indigo-400">#PyTorch #InfoNCE #FiQA #retrieval</span>
        </a>
        <a href="/projects/studymate" class="group grid grid-rows-subgrid row-span-3 pt-5 pb-6 border-t border-slate-800 hover:border-indigo-400/70 transition">
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-300 transition">StudyMate</h3>
          <p class="text-sm text-slate-400 mb-4">A RAG agent that answers from my lecture notes with citations and quizzes me on them — 96% Hit@4 on a reproducible retrieval eval.</p>
          <span class="text-xs font-mono text-indigo-400">#RAG #LangChain #Chroma #Evaluation</span>
        </a>
      </div>
    </section>

    <div class="h-px bg-gradient-to-r from-transparent via-slate-700/50 to-transparent"></div>

    <!-- Latest Posts -->
    <section class="py-20">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="text-sm font-bold uppercase tracking-widest text-indigo-500">Latest Posts</h2>
        <a href="/blog" class="text-sm text-slate-400 hover:text-indigo-400 transition">All posts →</a>
      </div>
      <ul class="space-y-2">
        {posts.map(post => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 px-3 -mx-3 rounded-xl hover:bg-slate-900/60 transition"
            >
              <time
                datetime={post.data.date.toISOString().slice(0, 10)}
                class="shrink-0 text-sm font-mono text-slate-450 w-32 whitespace-nowrap"
              >
                {formatDate(post.data.date)}
              </time>
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-indigo-300 transition mb-1">{post.data.title}</h3>
                <p class="text-sm text-slate-400 mb-2">{post.data.description}</p>
                <div class="flex gap-2 flex-wrap">
                  {post.data.tags.map(tag => (
                    <span class="text-xs font-mono text-indigo-400">#{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>
