---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/Layout.astro';

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const statusLabel = {
  'in-progress': { text: 'In progress', class: 'text-amber-400 border-amber-400/30 bg-amber-400/10' },
  'completed': { text: 'Completed', class: 'text-emerald-400 border-emerald-400/30 bg-emerald-400/10' },
  'archived': { text: 'Archived', class: 'text-slate-500 border-slate-600/30 bg-slate-600/10' },
};
---

<BaseLayout title="Projects · Retrograde Resonance" description="Projects by Eric Lin — applied AI, machine learning, and data science builds, with write-ups on what worked and what didn't.">
  <div class="max-w-4xl mx-auto px-6 py-12">

    <section class="py-8 border-b border-slate-800 mb-12">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">Projects</h1>
      <p class="text-lg text-slate-400">Things I've built, and what I learned building them.</p>
    </section>

    {projects.length === 0 && (
      <p class="text-slate-500">No projects yet. Add files under <code class="text-cyan-300 font-mono text-sm">src/content/projects/</code> to get started.</p>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => {
        const status = statusLabel[project.data.status];
        return (
          <a href={`/projects/${project.id}`} class="group flex flex-col p-6 rounded-2xl border border-slate-800 bg-slate-900/50 hover:border-indigo-500/50 transition">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="text-xl font-bold text-white group-hover:text-indigo-300 transition">{project.data.title}</h3>
              <span class={`text-xs px-2 py-0.5 rounded-full border shrink-0 ${status.class}`}>{status.text}</span>
            </div>
            <p class="text-sm text-slate-400 mb-4 flex-1">{project.data.description}</p>
            <div class="flex gap-2 flex-wrap">
              {project.data.tech.map((t) => (
                <span class="text-xs font-mono text-indigo-400">#{t}</span>
              ))}
            </div>
          </a>
        );
      })}
    </div>

  </div>
</BaseLayout>
