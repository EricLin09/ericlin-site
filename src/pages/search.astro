---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout
  title="Search · Retrograde Resonance"
  description="Full-text search across every project write-up and blog post on Retrograde Resonance."
>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <div class="max-w-3xl mx-auto px-6 py-12">

    <section class="py-8 border-b border-slate-800 mb-10">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">Search</h1>
      <p class="text-lg text-slate-400">Full-text search across every project write-up and blog post.</p>
    </section>

    <div id="search"></div>
    <p id="search-offline" hidden class="text-sm text-slate-400">
      The search index is generated by <code class="font-mono text-cyan-300">npm run build</code>. Build once, then reload this page.
    </p>

  </div>

  <!-- 索引和界面脚本都是构建时由 pagefind 生成的，不经过 Astro 打包 -->
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    (() => {
      // 开发时还没构建过，上面的脚本 404，PagefindUI 不存在
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search-offline').hidden = false;
        return;
      }
      const ui = new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        autofocus: true,
        translations: { placeholder: 'Search the site' },
      });
      // 搜索词同步到地址栏：刷新、返回、分享链接都能还原同一组结果
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
      document.getElementById('search').addEventListener('input', (e) => {
        const term = e.target.value.trim();
        history.replaceState(null, '', term ? `?q=${encodeURIComponent(term)}` : location.pathname);
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  /* pagefind 界面默认白底；它的变量定义在 :root 上，放到 #search 上就近覆盖 */
  #search {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--color-indigo-400);
    --pagefind-ui-text: var(--color-slate-200);
    --pagefind-ui-background: var(--color-slate-900);
    --pagefind-ui-border: var(--color-slate-800);
    --pagefind-ui-tag: var(--color-slate-800);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: inherit;
  }
  #search .pagefind-ui__result-link {
    color: var(--color-white);
  }
  #search .pagefind-ui__result-excerpt {
    color: var(--color-slate-400);
  }
  /* 命中词：和全站选中文字同一种靛蓝底，而不是浏览器默认的黄底 */
  #search mark {
    background: color-mix(in oklab, var(--color-indigo-500) 30%, transparent);
    color: var(--color-white);
    border-radius: 2px;
  }
</style>
